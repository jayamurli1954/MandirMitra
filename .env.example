# MandirMitra Environment Variables
# Copy this file: cp .env.example .env
# Then fill in REAL values in .env
# NEVER commit .env to GitHub!

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mandirmitra

# Authentication
SECRET_KEY=your-secret-key-minimum-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cache
REDIS_URL=redis://localhost:6379

# Frontend
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Panchang Location Default (for Bengaluru)
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946
DEFAULT_TIMEZONE=Asia/Kolkata
