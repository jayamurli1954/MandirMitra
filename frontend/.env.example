# Local development
REACT_APP_API_URL=http://localhost:8000

# Vercel preview + production: set these in Vercel project Environment Variables.
# Use the production Render backend URL for production deployments.
REACT_APP_FALLBACK_API_URL=https://your-render-backend.onrender.com

# Google Sign-In (unified auth backend)
REACT_APP_GOOGLE_CLIENT_ID=
# Keep empty by default. First-time Google users should go through onboarding.
REACT_APP_DEFAULT_TENANT_ID=
REACT_APP_APP_KEY=mandirmitra
